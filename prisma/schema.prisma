// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

enum Gender {
    male
    female
    both
    unknown
}

type Location {
    address               String
    city                  String
    province              String
    district              String
    divisionalSecretariat String
    google                String
    latitude              Float?
    longitude             Float?
}

type Contact {
    phone     String[]
    email     String[]
    website   String
    facebook  String
    instagram String
}

type Occupancy {
    total  Int?
    male   Int?
    female Int?
}

type AgeRanges {
    all    String?
    male   String?
    female String?
}

// A phone number or email address confirmed by contacting the facility
type VerifiedValue {
    value      String
    verifiedAt DateTime
}

// The occupancy counts that were confirmed, so later changes to the counts
// aren't shown as verified
type VerifiedOccupancy {
    total      Int?
    male       Int?
    female     Int?
    verifiedAt DateTime
}

// The age ranges that were confirmed, so later changes to them aren't shown
// as verified
type VerifiedAgeRanges {
    all        String?
    male       String?
    female     String?
    verifiedAt DateTime
}

// Fields confirmed by contacting the facility directly. Each verification is
// tied to the value that was confirmed, so a changed value loses its verification.
type Verification {
    phones    VerifiedValue[]
    emails    VerifiedValue[]
    occupancy VerifiedOccupancy?
    ageRanges VerifiedAgeRanges?
}

// A facility's text in another language. A missing or empty field falls
// back to the English value.
type FacilityTranslation {
    name        String?
    description String?
    address     String?
    city        String?
    managedBy   String?
}

// One entry per language besides English, so Tamil can add a `ta` entry
type FacilityTranslations {
    si FacilityTranslation?
}

type PhotoEntry {
    fileName String
    source   String
}

model ChildCareFacility {
    id           String        @id @default(auto()) @map("_id") @db.ObjectId
    name         String        @unique
    slug         String        @unique
    type         String
    managedBy    String
    description  String
    location     Location
    contact      Contact
    occupancy    Occupancy
    ageRanges    AgeRanges
    genders      Gender
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt
    photos       PhotoEntry[]
    sources      String[]
    // Optional so existing documents without it need no migration
    verification Verification?
    // Optional for the same reason
    translations FacilityTranslations?

    @@map("facilities")
}
